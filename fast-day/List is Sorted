stack=[]
def checkValid(input):
   for x in input:
      if(x=="("or "[" or "{"):
         stack.append(x)
      else:
         Topvalue=stack[-1]
         if(x==")"  or x=="]"  or x=="}" and Topvalue=="("or Topvalue=="["or Topvalue=="{"):
            stack.pop()
         else:
            return False
   if(len(stack)==0):
      return True
   else:
      return False

